{
  "name": "web_crawler",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "type": "module",
  "description": "A configurable TypeScript crawler with HTTP and optional Playwright backends, robots.txt support, and JSON/CSV exports.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "crawl": "tsx src/cli.ts",
    "web": "tsx src/web.ts",
    "start:web": "node dist/web.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "web-crawler",
    "web-scraping",
    "typescript",
    "playwright",
    "cheerio"
  ],
  "author": "Keshav Chauhan",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keshav833/Web_Crawler.git"
  },
  "bugs": {
    "url": "https://github.com/Keshav833/Web_Crawler/issues"
  },
  "homepage": "https://github.com/Keshav833/Web_Crawler#readme",
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
